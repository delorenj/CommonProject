# mise configuration for {{ project_name }}
# https://mise.jdx.dev/configuration.html

[env]
_.path = [".mise/scripts", "agents/hermes/pm"]
_.file = [".env"]

# This block will handle the linking of
# agent files to the main AGENTS.md file.
#
# TODO: Ensure this works for all levels of nesting.
# i.e. All linked agent files MUST be siblings at
# any given level of nesting.
#
# NOTE: hooks are an array of [[hooks.enter]] tables (NOT enter = [ ... ]) and
# every {{config_root}} path is single-quoted so it survives a space in the
# project path — mise runs each `script` via `sh -c`.
[[hooks.enter]]
script = "'{% raw %}{{config_root}}{% endraw %}/.mise/scripts/link-agentfiles.sh'"
[[hooks.enter]]
# Atomic (PJAN-24): ANY `op inject ... > .env` form truncates a populated .env
# before `op` ever runs — the shell opens the redirection first. Guarding on
# .env.op/op is not enough: an expired op session passes both guards and still
# destroys .env. Materialize into a umask-077 mktemp file in the project dir and
# `mv` it over .env only on a real success; on any failure remove the temp and
# leave .env byte-for-byte intact. `|| true` keeps shell entry safe under set -e.
script = "[ -f '{% raw %}{{config_root}}{% endraw %}/.env.op' ] && command -v op >/dev/null 2>&1 && { CDPATH= cd '{% raw %}{{config_root}}{% endraw %}' && umask 077 && t=$(mktemp .env.inject.XXXXXX) && op inject -i .env.op -o $t --force && mv $t .env || rm -f $t; } || true"
[[hooks.enter]]
script = "python3 '{% raw %}{{config_root}}{% endraw %}/.mise/scripts/provision-packs.py'"
[[hooks.enter]]
script = "python3 '{% raw %}{{config_root}}{% endraw %}/.mise/scripts/sync-skills.py' --scope project"
[[hooks.enter]]
script = "[ -f '{% raw %}{{config_root}}{% endraw %}/.mise/scripts/codegraph.sh' ] && '{% raw %}{{config_root}}{% endraw %}/.mise/scripts/codegraph.sh' || true"
{%- if agent_hooks_layer %}
[[hooks.enter]]
script = "'{% raw %}{{config_root}}{% endraw %}/.agents/hooks/sync.py' --install --quiet"
{%- endif %}
{%- if agent_hooks_layer %}
[[hooks.leave]]
script = "'{% raw %}{{config_root}}{% endraw %}/.agents/hooks/sync.py' --uninstall --quiet"
{%- endif %}

[[watch_files]]
patterns = ["AGENTS.md"]
task = "link-agentfiles"
[[watch_files]]
patterns = [".agents/skills.json"]
task = "skills-sync"
{% if agent_hooks_layer %}
# Re-fan-out the agent hooks whenever the single source of truth changes.
[[watch_files]]
patterns = [".agents/hooks/hooks.master.json"]
task = "hooks-sync"
{% endif %}
[tasks.link-agentfiles]
description = "Symlink all agent files to AGENTS.md"
run = "'{% raw %}{{config_root}}{% endraw %}/.mise/scripts/link-agentfiles.sh'"

[tasks.skills-sync]
description = "Sync skills from manifest to local CLI dirs"
depends = ["skills-provision-packs"]
run = "python3 '{% raw %}{{config_root}}{% endraw %}/.mise/scripts/sync-skills.py' --scope project"

[tasks.skills-provision-packs]
description = "Provision every Skillex pack declared in .agents/skills.json"
run = "python3 '{% raw %}{{config_root}}{% endraw %}/.mise/scripts/provision-packs.py'"
{% if agent_hooks_layer %}
# --- Project-scoped agent hooks + skill fan-out (see .agents/hooks/README.md) ---

[tasks.hooks-sync]
description = "Fan out .agents/hooks/hooks.master.json to each agent CLI (claude committed; codex/kimi injected; hermes adapter)"
run = "'{% raw %}{{config_root}}{% endraw %}/.agents/hooks/sync.py' --install"

[tasks.hooks-check]
description = "Drift gate: verify generated hook configs match hooks.master.json (CI-safe, read-only)"
run = "'{% raw %}{{config_root}}{% endraw %}/.agents/hooks/sync.py' --check"

[tasks.hooks-uninstall]
description = "Remove per-user agent-hook injections (codex/kimi/hermes)"
run = "'{% raw %}{{config_root}}{% endraw %}/.agents/hooks/sync.py' --uninstall"
{% endif %}
[tasks.hindsight-setup]
description = "Provision this dev's shared project Hindsight key from 1Password into .env (op read; upserts those two keys, leaves the rest of .env intact)"
run = "'{% raw %}{{config_root}}{% endraw %}/.mise/scripts/hindsight-setup.sh'"
